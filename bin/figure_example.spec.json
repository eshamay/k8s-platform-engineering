    {"id": "gitops", "type": "box", "x": 260, "y": 140, "w": 170, "h": 80, "label": "GitOps controllers", "style": "controller"},
    {"id": "api", "type": "box", "x": 500, "y": 110, "w": 170, "h": 140, "label": "Kubernetes API\n(desired state)", "style": "store"},
    {"id": "domain", "type": "box", "x": 740, "y": 140, "w": 100, "h": 80, "label": "Domain\ncontrollers", "style": "controller", "fs": 15},
    {"id": "world", "type": "box", "x": 880, "y": 140, "w": 80, "h": 80, "label": "Cloud\nAPIs", "style": "hub", "fs": 15},
