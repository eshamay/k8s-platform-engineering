    {"id": "e4", "type": "arrow", "from": "domain", "to": "world", "kind": "apply", "label": "call"},
    {"id": "s1", "type": "text", "x": 260, "y": 60, "text": "Layer 1: Git into the API", "fs": 15, "color": "purple"},
    {"id": "s2", "type": "text", "x": 600, "y": 60, "text": "Layer 2: the API into reality", "fs": 15, "color": "purple"}
  ],
  "legend": [
    {"kind": "pull", "text": "fetch desired state"},
